    "id": "dieback",
    "identification": "Progressive drying of twigs from tips backward. Dark discolouration of affected branches. Bark peeling.",
    "name": "Dieback",
    "organicPrevention": [
      "Prune dead wood promptly",
      "Maintain balanced nutrition",
    ],
    "organicTreatments": [
      {
        "effort": "moderate",
        "frequency": "As soon as dieback is noticed; monitor cut ends for further progression",
        "howToApply": "Cut affected branch 10–15 cm below the visible dieback margin, cutting back into firm healthy green wood. Burn all removed material immediately.",
        "method": "manual",
        "name": "Prune and burn affected branches",
        "safetyNotes": "Always cut back to healthy wood — cutting within affected tissue allows disease to continue progressing. Disinfect tools between cuts with 1% bleach solution.",
        "timing": "During dry weather — avoid pruning in rain to prevent fungal entry",
      },
      {
        "effort": "moderate",
        "frequency": "Apply immediately after each pruning cut — do not delay",
        "howToApply": "Make a thick paste of copper oxychloride (100 g in 200 ml water). Paint directly onto all pruning wounds and exposed wood immediately after cutting, using a brush.",
        "method": "spray",
        "name": "Copper fungicide paste on cuts",
        "safetyNotes": "Every fresh cut is a fungal entry point — never leave pruning wounds unsealed in dieback-prone areas like mango orchards. Wear gloves.",
        "timing": "Immediately after cutting, before spores can enter",
      },
      {
        "effort": "easy",
        "frequency": "Once per season at the start of the growing period",
        "howToApply": "Apply balanced organic fertiliser (compost + neem cake + bone meal or wood ash) to the root zone. Test soil pH — dieback is worsened by acidic soil or potassium deficiency.",
        "method": "cultural",
        "name": "Balanced nutrition",
        "safetyNotes": "Stressed, nutrient-deficient plants are far more susceptible to dieback. Adequate potassium improves plant disease resistance.",
        "timing": "Pre-monsoon or pre-fruiting stage",
      },
    ],
    "plantsAffected": [
      "Chilli",
      "Mango",
      "Guava",
    ],
    "seasonalRisk": {
      "cool_dry": "moderate",
      "summer": "moderate",
